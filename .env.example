GEMINI_API_KEY=your_gemini_api_key_here

# Server Ports
DASHBOARD_PORT=8502
API_PORT=8000

# Chat Session (security-and-test-improvement)
CHAT_SESSION_TTL_SEC=1800
CHAT_SESSION_MAX_PER_IP=20
CHAT_SESSION_MAX_TOTAL=1000

# Custom Query Safety
CUSTOM_QUERY_TIMEOUT_SEC=10
# Semicolon-separated absolute paths; empty = use default (database/archive_2025.db)
ARCHIVE_DB_WHITELIST=

# CORS — comma-separated allowed origins for browser frontends.
# Empty = use built-in defaults (localhost + dev server 192.168.200.107).
# Do NOT use "*" — allow_credentials=True forbids wildcard origins.
CORS_ORIGINS=

# API Authentication (auth-audit-v1) — opt-in. Default OFF preserves open access.
# When true, every non-public route requires either a matching X-API-Key header
# or an Authorization: Bearer <token> header. Health/docs paths stay public.
API_AUTH_ENABLED=false
# Comma-separated secret values. Used only when API_AUTH_ENABLED=true.
API_KEYS=
API_BEARER_TOKENS=

# Material Backup (materials-api-v1) — webcloring-pdf 봇이 자재요청을
# POST /materials/backup 으로 전송. 대시보드 "자재요청" 페이지에서 조회/다운로드.
#
# 대시보드 "지금 실행" 버튼이 같은 PC에서 봇 자동화(main.py --auto)를 기동.
# 웹에서 프로세스를 띄우므로 opt-in. true 일 때만 동작.
MATERIALS_RUN_ENABLED=false
# (선택) 봇 위치/실행 파이썬. 미설정 시 repo의 webcloring-pdf + uvicorn 파이썬.
# uvicorn 파이썬에 봇 deps(selenium 등)가 없으면 봇 venv 파이썬을 지정하세요.
MATERIALS_BOT_DIR=
MATERIALS_BOT_PYTHON=
# (선택) 대시보드→API 호출 시 보낼 키 (API_AUTH_ENABLED=true 인 경우).
MATERIALS_API_KEY=
